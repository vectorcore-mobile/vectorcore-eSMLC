tA2INTEGER (-64..63)OPTIONAL,-- Need ON
gnss-TO-IDINTEGER (1..15),
weekNumberINTEGER (0..8191)OPTIONAL,-- Need ON
deltaTINTEGER (-128..127)OPTIONAL,-- Need ON
...
}
