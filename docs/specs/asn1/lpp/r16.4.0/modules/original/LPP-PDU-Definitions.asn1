LPP-Message ::= SEQUENCE {
transactionIDLPP-TransactionIDOPTIONAL,-- Need ON
endTransactionBOOLEAN,
sequenceNumberSequenceNumberOPTIONAL,-- Need ON
acknowledgementAcknowledgementOPTIONAL,-- Need ON
lpp-MessageBodyLPP-MessageBodyOPTIONAL-- Need ON
}
SequenceNumber ::= INTEGER (0..255)
Acknowledgement ::= SEQUENCE {
ackRequestedBOOLEAN,
ackIndicatorSequenceNumberOPTIONAL
}

LPP-MessageBody ::= CHOICE {
c1CHOICE {
requestCapabilitiesRequestCapabilities,
provideCapabilitiesProvideCapabilities,
requestAssistanceDataRequestAssistanceData,
provideAssistanceDataProvideAssistanceData,
requestLocationInformationRequestLocationInformation,
provideLocationInformationProvideLocationInformation,
abortAbort,
errorError,
spare7 NULL, spare6 NULL, spare5 NULL, spare4 NULL,
spare3 NULL, spare2 NULL, spare1 NULL, spare0 NULL
},
messageClassExtensionSEQUENCE {}
}

